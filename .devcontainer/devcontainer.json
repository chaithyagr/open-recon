{
	"name": "python-ismrmrd-server-devcon",

	"build": {
		"dockerfile": "../docker/Dockerfile",
		"target":     "python-mrd-devcontainer",
		"context":    "../",
		"cacheFrom":  [
			"docker.io/kspacekelvin/fire-python-devcon",
			"docker.io/kspacekelvin/fire-python:buildcache"]
	},
	"runArgs": [
        "--gpus=all",
        "--net", "host",
        "-e", "DISPLAY=${env:DISPLAY}",
        "-e", "XAUTHORITY=/tmp/.Xauthority",
        "-v", "${localEnv:HOME}/.Xauthority:/tmp/.Xauthority",
        "--privileged"
    ],
    
    "mounts": [
        "type=bind,source=/tmp/.X11-unix,target=/tmp/.X11-unix,consistency=cached"
    ],
	// Use appPort to "publish" a port to the host machine. Compared to forwardPorts,
	// appPort allows connections from non-localhost
	"appPort": ["9020:9020"],

	// Default setting for Windows changes files to CRLF, so match this to avoid all files
	// being marked as changed.  Could be disabled for non-Windows hosts
	"postCreateCommand": "git config --global core.autocrlf true && pip install ipykernel",

	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"ms-python.python",
                "ms-vscode.cpptools",
                "ms-vscode.makefile-tools",
                "github.vscode-pull-request-github",
                "github.copilot",
                "zxh404.vscode-proto3",
                "ms-python.debugpy"
			],

			"settings": { 
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	}
}