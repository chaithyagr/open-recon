{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DICOM2MRD",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dicom2mrd.py",
            "console": "integratedTerminal",
            "args": [
                "-o", "3d_data.mrd",
                "data/t1_mpr-moco_tra_iso1mm_Brainmask_N4_Dn_7001_MR"
            ]
        },
        // Start server
        {
            "name": "Start server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "-p",
                "9020",
            ],
            "console": "integratedTerminal",
            "consoleTitle": "Server",
            "justMyCode": false,
        },
        // Run client
        {
            "name": "ICM",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/client.py",
            "args": [
                "/opt/code/python-ismrmrd-server/data/3d_data.mrd",
                "-p",
                "9020",
                "-c",
                "ants_icm",
                "-o",
                "/opt/code/python-ismrmrd-server/data/out.mrd"
            ],
            "console": "integratedTerminal",
            "consoleTitle": "Client",
            "justMyCode": false,
        },
        {
            "name": "sparkling",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/client.py",
            "args": [
                "/opt/code/python-ismrmrd-server/data/test.mrd",
                "-p", "9020",
                "-c", "sparkling",
                "-o", "/opt/code/python-ismrmrd-server/data/out.mrd"
            ],
            "console": "integratedTerminal",
            "consoleTitle": "Client",
            "justMyCode": false,
        },
    ],
    "compounds": [
        {
            "name": "Server + client",
            "configurations": [
                "Start server",
                "sparkling"
            ]
        },
    ]
}